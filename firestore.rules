rules_version = '2';
// Access is limited to signed-in accounts with a verified email whose email has a document in "allowed".
// That document holds the person's role ("admin" has everything), sections and permissions,
// all edited from the site settings pages by an admin. The first admin is set by hand in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email;
    }
    function me() {
      return /databases/$(database)/documents/allowed/$(myEmail());
    }
    function allowed() {
      return signedIn() && exists(me());
    }
    function profile() {
      return get(me()).data;
    }
    function isAdmin() {
      return allowed() && profile().get("role", "") == "admin";
    }
    // letters permissions: submit is on by default; older records may carry canIssue
    function perm(k) {
      return isAdmin() || (allowed() && profile().get("perms", {}).get(k, k == "submit" || (k == "issue" && profile().get("canIssue", false))));
    }
    // sections a member can open (all three when not set)
    function section(s) {
      return isAdmin() || (allowed() && s in profile().get("sections", ["tasks", "governance", "hr"]));
    }

    // people: everyone may read their own entry; admins manage the list but cannot remove or demote themselves
    match /allowed/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && (email != myEmail() || request.resource.data.get("role", "") == "admin");
      allow delete: if isAdmin() && email != myEmail();
    }

    // site settings, fonts and slider: everyone reads, admins change
    match /settings/{id} {
      allow read: if allowed();
      allow write: if isAdmin();
    }
    match /fonts/{id} {
      allow read: if allowed();
      allow write: if isAdmin();
    }
    match /fontChunks/{id} {
      allow read: if allowed();
      allow write: if isAdmin();
    }
    match /slides/{id} {
      allow read: if allowed();
      allow write: if isAdmin();
    }
    match /prefs/{id} {
      allow read, write: if allowed();
    }

    // tasks
    match /tasks/{id} {
      allow read, write: if section("tasks");
    }

    // governance library (policies and associations are also read by the letters and the home page)
    match /policies/{id} {
      allow read: if allowed();
      allow write: if section("governance");
    }
    match /associations/{id} {
      allow read: if allowed();
      allow write: if section("governance");
    }
    match /letterheads/{id} {
      allow read, write: if section("governance");
    }
    match /versions/{id} {
      allow read, write: if section("governance");
    }
    match /vindex/{id} {
      allow read, write: if section("governance");
    }

    // letters settings
    match /hrTemplates/{id} {
      allow read: if allowed();
      allow write: if perm("templates");
    }
    match /hrHeads/{id} {
      allow read: if allowed();
      allow write: if perm("heads");
    }
    match /hrMeta/{id} {
      allow read: if allowed();
      allow write: if (id == "seal" && perm("seal")) || (id == "templates" && perm("templates")) || (id == "counter" && counterStep());
    }

    // the outgoing-number counter only moves forward one at a time (back to 1 when the Hijri year changes)
    function counterStep() {
      let n = request.resource.data;
      return allowed() && n.keys().hasOnly(["year", "last"])
        && (resource == null ? n.last == 1
            : (n.year == resource.data.year ? n.last == resource.data.last + 1 : n.last == 1));
    }
    // a stand-in approver: delegations/{approver} = { to, startMs, endMs } while the dates last
    function delegateFor(e) {
      let p = /databases/$(database)/documents/delegations/$(e);
      return exists(p) && get(p).data.to == myEmail()
        && request.time.toMillis() >= get(p).data.startMs && request.time.toMillis() < get(p).data.endMs;
    }
    function actsFor(list) {
      return myEmail() in list
        || (list.size() > 0 && delegateFor(list[0])) || (list.size() > 1 && delegateFor(list[1])) || (list.size() > 2 && delegateFor(list[2]));
    }
    // the approver of a request's last stage, at the moment the letter is issued
    function finalApprover(rid) {
      let r = get(/databases/$(database)/documents/requests/$(rid)).data;
      return r.status == "pending" && r.stageIndex == r.stages.size() - 1
        && (isAdmin() || (actsFor(r.get("currentApprovers", [])) && r.submittedBy != myEmail()));
    }

    // issued letters: everyone sees their own, the whole log needs viewLog
    match /hrLetters/{id} {
      allow read: if perm("viewLog") || (allowed() && resource.data.createdBy == myEmail());
      allow create: if (perm("issue") && request.resource.data.createdBy == myEmail())
                    || (allowed() && request.resource.data.get("requestId", null) != null && finalApprover(request.resource.data.requestId));
      // a letter is cancelled with a reason (its number stays in the log); only an admin removes one for good
      allow update: if perm("editIssued")
                    || (perm("deleteLog") && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "cancelReason", "cancelNote", "cancelledBy", "cancelledAt"]));
      allow delete: if isAdmin();
      // earlier wording of a letter, kept each time an issued letter is edited
      match /versions/{v} {
        allow read: if perm("viewLog");
        allow create: if perm("editIssued");
        allow delete: if isAdmin();
      }
    }

    // each approver names their own stand-in for a period
    match /delegations/{email} {
      allow read: if allowed();
      allow create, update: if allowed() && (email == myEmail() || isAdmin()) && request.resource.data.to != email
                            && request.resource.data.endMs > request.resource.data.startMs;
      allow delete: if allowed() && (email == myEmail() || isAdmin());
    }

    // the path is copied from settings/workflows when the request is made and can't be changed afterwards;
    // currentApprovers always holds the emails of the stage the request waits at
    function samePath() {
      return request.resource.data.stages == resource.data.stages
        && request.resource.data.submittedBy == resource.data.submittedBy
        && request.resource.data.get("wfIndex", null) == resource.data.get("wfIndex", null);
    }
    function approversFollow() {
      let n = request.resource.data;
      return n.status == "pending" ? n.currentApprovers == n.stages[n.stageIndex].emails : n.currentApprovers.size() == 0;
    }
    // an approver of the current stage, never on their own request: next stage, edit, return, reject, or final approval
    function asApprover() {
      let o = resource.data; let n = request.resource.data;
      return o.status == "pending" && actsFor(o.get("currentApprovers", [])) && o.submittedBy != myEmail()
        && ((n.status == "pending" && (n.stageIndex == o.stageIndex || n.stageIndex == o.stageIndex + 1))
            || (n.status in ["returned", "rejected"] && n.stageIndex == o.stageIndex)
            || (n.status == "approved" && n.stageIndex == o.stageIndex && o.stageIndex == o.stages.size() - 1));
    }
    // the person who made it: withdraw it, or send it again from the first stage
    function asSubmitter() {
      let o = resource.data; let n = request.resource.data;
      return o.submittedBy == myEmail() && o.status in ["pending", "returned"]
        && ((n.status == "cancelled" && n.stageIndex == o.stageIndex)
            || (n.status == "pending" && (n.stageIndex == 0 || (o.status == "returned" && n.stageIndex == o.stageIndex))))
        && n.get("letterId", null) == o.get("letterId", null) && n.get("ref", null) == o.get("ref", null);
    }
    match /requests/{id} {
      allow read: if allowed();
      allow create: if perm("submit") && request.resource.data.submittedBy == myEmail()
                    && request.resource.data.status == "pending" && request.resource.data.stageIndex == 0
                    && request.resource.data.stages == get(/databases/$(database)/documents/settings/workflows).data.list[request.resource.data.wfIndex].stages
                    && request.resource.data.currentApprovers == request.resource.data.stages[0].emails
                    && request.resource.data.get("letterId", null) == null && request.resource.data.get("ref", null) == null;
      allow update: if isAdmin() || (allowed() && samePath() && approversFollow() && (asApprover() || asSubmitter()));
      allow delete: if isAdmin();
    }
  }
}
